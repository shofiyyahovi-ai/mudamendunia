<script>
  let currentStep = 1;
  const totalSteps = 7;

  function goTo(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById('screen-' + id).classList.add('active');
  }

  function skipToMain() { goTo('result'); }

  function updateProgress() {
    const pct = Math.round((currentStep / totalSteps) * 100);
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('progressLabel').textContent = currentStep + ' dari ' + totalSteps;
    document.getElementById('prevBtn').style.display = currentStep > 1 ? 'inline-flex' : 'none';
    document.getElementById('nextBtn').textContent = currentStep === totalSteps ? 'Lihat Hasil ✦' : 'Lanjut →';
  }

  function nextStep() {
    if (currentStep === totalSteps) {
      const nameInput = document.getElementById('userName');
      const name = nameInput && nameInput.value.trim() ? nameInput.value.trim() : 'Arya';
      document.getElementById('displayName').textContent = name;
      document.querySelector('.sidebar-avatar').textContent = name.charAt(0).toUpperCase();
      goTo('result');
      return;
    }
    document.querySelector('.onboard-step[data-step="' + currentStep + '"]').classList.remove('active');
    currentStep++;
    document.querySelector('.onboard-step[data-step="' + currentStep + '"]').classList.add('active');
    updateProgress();
  }

  function prevStep() {
    if (currentStep <= 1) return;
    document.querySelector('.onboard-step[data-step="' + currentStep + '"]').classList.remove('active');
    currentStep--;
    document.querySelector('.onboard-step[data-step="' + currentStep + '"]').classList.add('active');
    updateProgress();
  }

  function selectOpt(el, multi) {
    if (!multi) {
      el.closest('.options-grid').querySelectorAll('.option-card').forEach(c => c.classList.remove('selected'));
    }
    el.classList.toggle('selected');
  }

  function updateSlider(el, outId) {
    const v = parseInt(el.value);
    const id = el.id;
    const labels = {
      sl1: v < 30 ? 'Introvert 🎧' : v < 60 ? 'Mostly Introvert 🎧' : v < 80 ? 'Ambivert 🌗' : 'Extrovert 🎉',
      sl2: v < 30 ? 'Sangat Emosional 💫' : v < 60 ? 'Seimbang 🧬' : v < 80 ? 'Cenderung Logis 🧠' : 'Sangat Logis 🔬',
      sl3: v < 30 ? 'Rutinitas 📅' : v < 60 ? 'Fleksibel 🌀' : v < 80 ? 'Explorer 🧭' : 'Petualang 🚀'
    };
    document.getElementById(outId).textContent = labels[id];
  }

  function switchTab(name) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    document.getElementById('nav-' + name).classList.add('active');
  }

  function openChat(name, emoji, tags) {
    switchTab('chat');
  }

  function setActiveChat(el, name, initial, bg, color, compat) {
    document.querySelectorAll('.chat-list-item').forEach(i => i.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('chatAvatar').textContent = initial;
    document.getElementById('chatAvatar').style.background = bg;
    document.getElementById('chatAvatar').style.color = color;
    document.getElementById('chatName').textContent = name;
    document.getElementById('chatCompat').textContent = '✦ ' + compat + ' kecocokan';
    // update incoming avatars
    document.querySelectorAll('#msgAvatarInc, #msgAvatarInc2').forEach(a => {
      a.textContent = initial; a.style.background = bg; a.style.color = color;
    });
  }

  function sendMessage() {
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if (!text) return;
    const area = document.getElementById('messagesArea');
    const msg = document.createElement('div');
    msg.className = 'msg outgoing';
    msg.innerHTML = `<div class="msg-avatar" style="background:linear-gradient(135deg,#8BB8FF,#5B8DEF);color:#fff">A</div><div class="msg-bubble">${text}</div>`;
    area.appendChild(msg);
    input.value = '';
    area.scrollTop = area.scrollHeight;

    // Simulate reply
    setTimeout(() => {
      const replies = [
        'Iya, aku ngerti banget perasaan itu! 🤍',
        'Haha beneran relate sama yang kamu bilang.',
        'Wah menarik! Gimana kamu bisa sampai di pandangan itu?',
        'Aku juga ngerasain hal yang sama sebenarnya...',
        'Makanya kita nyambung kayaknya 😄'
      ];
      const reply = replies[Math.floor(Math.random() * replies.length)];
      const chatAvatar = document.getElementById('chatAvatar');
      const replyMsg = document.createElement('div');
      replyMsg.className = 'msg incoming';
      replyMsg.innerHTML = `<div class="msg-avatar" style="background:${chatAvatar.style.background};color:${chatAvatar.style.color}">${chatAvatar.textContent}</div><div class="msg-bubble">${reply}</div>`;
      area.appendChild(replyMsg);
      area.scrollTop = area.scrollHeight;
    }, 1200);
  }

  function handleEnter(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  }

  function sendStarter(btn) {
    document.getElementById('chatInput').value = btn.textContent;
    sendMessage();
  }

  function toggleLike(el) {
    const isLiked = el.classList.toggle('liked');
    const num = parseInt(el.textContent.replace(/[^0-9]/g, ''));
    el.textContent = (isLiked ? '♥ ' : '♡ ') + (isLiked ? num + 1 : num - 1);
  }

  function toggleReact(el) {
    el.style.borderColor = el.style.borderColor ? '' : 'var(--border)';
    el.style.color = el.style.color === 'var(--brand-mid)' ? '' : 'var(--brand-mid)';
  }

  function selectCat(el) {
    el.closest('.anon-cats').querySelectorAll('.anon-cat').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
  }

  function postAnon() {
    const ta = document.querySelector('.anon-textarea');
    if (!ta.value.trim()) return;
    ta.value = '';
    const posts = document.querySelector('.anon-posts');
    const post = document.createElement('div');
    post.className = 'anon-post';
    post.style.borderColor = 'rgba(91,141,239,0.4)';
    post.innerHTML = `<div class="anon-post-header"><div class="anon-mask">✨</div><div class="anon-post-meta"><div class="anon-handle">kamu (anonim)</div></div><div class="spacer"></div><div class="anon-cat-badge" style="background:rgba(91,141,239,0.15);color:var(--brand-mid)">Baru saja</div></div><div class="anon-post-text">Pesanmu sudah dibagikan secara anonim. Komunitas mendengar kamu. 🤍</div><div class="anon-reactions"><div class="react-btn">🤍 0</div></div>`;
    posts.insertBefore(post, posts.firstChild);
    setTimeout(() => post.style.borderColor = '', 3000);
  }
</script>
</body>
</html>
